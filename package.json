{
  "name": "datapack-crossref",
  "displayName": "datapack-crossref",
  "description": "Minecraft Datapack cross-reference extension",
  "version": "0.0.2",
  "publisher": "yuki94null",
  "repository": {
    "type": "git",
    "url": "https://github.com/yuki94null/datapack-crossref.git"
  },
  "engines": {
    "vscode": "^1.125.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onLanguage:mcfunction"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "datapack-crossref.scanDatapack",
        "title": "Scan Datapack"
      },
      {
        "command": "datapack-crossref.removeCrossRef",
        "title": "Remove CrossRef"
      },
      {
        "command": "datapack-crossref.makeCrossRef",
        "title": "Make CrossRef"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.125.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "typescript-eslint": "^8.61.1",
    "eslint": "^10.5.0",
    "typescript": "^6.0.3",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  }
}
